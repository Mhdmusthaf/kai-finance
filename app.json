{
  "expo": {
    "name": "KAI — Your Money OS",
    "slug": "kai-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kai",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D2E"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kai.money",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "KAI requires microphone access to parse voice transactions and expense logging.",
        "NSSpeechRecognitionUsageDescription": "KAI requires speech recognition to transcribe your voice commands.",
        "NSFaceIDUsageDescription": "KAI uses Face ID to securely authenticate and protect your private financial data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3D2E"
      },
      "package": "app.kai.money",
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c2e5ac57-56e7-4797-8aae-ed9d2a8f895a"
      }
    }
  }
}
