{
  "name": "kai-finance",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "auto-push": "node scripts/auto-sync.js",
    "setup-assets": "node scripts/setup-assets.js",
    "postinstall": "node scripts/setup-assets.js",
    "prebuild": "node scripts/setup-assets.js && expo prebuild",
    "build:android": "eas build --platform android --profile production",
    "build:apk": "eas build --platform android --profile production-apk",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.2.3",
    "@expo-google-fonts/nunito-sans": "^0.2.3",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.7",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-modules-core": "~1.12.26",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "babel-preset-expo": "~11.0.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
