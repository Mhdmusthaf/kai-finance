# Server environment — NEVER commit real values

# Postgres connection string (Neon / Supabase-Postgres / Railway / local docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kai

# Auth — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated allow-list of origins (the admin panel URL, etc.)
CORS_ORIGINS=http://localhost:3000

# OTP provider: 'console' (DEV ONLY — hard-disabled when NODE_ENV=production) | msg91 | twilio
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Gemini (voice parse + Ask My Money) — server-only, never shipped to client
GEMINI_API_KEY=

# Sentry
SENTRY_DSN=

# Seed admin email for the admin panel (gets superadmin on first boot)
ADMIN_SEED_EMAIL=admin@kai.local

# Object storage for the Document Vault (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# RevenueCat webhook secret
REVENUECAT_WEBHOOK_SECRET=
